{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/blokker-sporet-env.mjs"],
            "timeout": 15,
            "statusMessage": "Sjekker at env-fila ikke ligger i git..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/bildesperre.mjs"],
            "timeout": 150,
            "statusMessage": "Sjekker bildereglene mot basen..."
          }
        ]
      }
    ]
  }
}
